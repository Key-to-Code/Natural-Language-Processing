import numpy as np
import matplotlib.pyplot as plt
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.decomposition import PCA
from sklearn.metrics.pairwise import cosine_similarity

docs = [
    "eating healthy salads with tomatoes and cucumber",
    "pasta with rich tomato sauce and cheese",
    "grilled chicken salad with olive oil dressing"
]

# Define your search query
query = "healthy tomato salad"

all_texts = docs + [query]

vectorizer = TfidfVectorizer(stop_words='english')
tfidf_matrix = vectorizer.fit_transform(all_texts) [cite: 72]
tfidf_array = tfidf_matrix.toarray() [cite: 73, 74]

doc_vectors = tfidf_array[:len(docs)]
query_vector = tfidf_array[-1].reshape(1, -1)

cos_sim = cosine_similarity(doc_vectors, query_vector).flatten()

pca = PCA(n_components=2)
reduced_vectors = pca.fit_transform(tfidf_array) [cite: 83]

plt.figure(figsize=(8, 6)) [cite: 85]
labels = [f'D{i+1}' for i in range(len(docs))] + ['Query']
colors = ['blue', 'green', 'red', 'black'] 

for i, (x, y) in enumerate(reduced_vectors): [cite: 88]
    plt.scatter(x, y, color=colors[i % len(colors)], label=labels[i], s=100) [cite: 89]
    plt.text(x + 0.01, y + 0.01, labels[i], fontsize=12) [cite: 90]

plt.title('TF-IDF Vectors in 2D (PCA)') [cite: 91]
plt.xlabel('PCA Component 1') [cite: 92]
plt.ylabel('PCA Component 2') [cite: 93]
plt.legend() [cite: 94]
plt.grid(True) [cite: 95]

plt.savefig('food_tfidf_vectors.png')
plt.close() [cite: 98]

print("Cosine Similarities:")
for i, sim in enumerate(cos_sim, 1):
    print(f"D{i} vs Query: {sim:.3f}")